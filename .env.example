# Copy to `secrets/.env` and fill in real values. ⚠️ Rotate secrets after testing.
# The `secrets/` directory is git-ignored so API keys never leak into version control.

# LLM provider: "deepseek" (default) or "gemini"
LLM_PROVIDER=deepseek

# Deepseek (OpenAI-compatible) — https://api-docs.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Gemini (optional) — https://ai.google.dev/gemini-api/docs/quickstart
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-3.5-flash

# Hugging Face token for gated EmbeddingGemma (downloads into ./model)
HF_TOKEN=your_hf_token_here
EMBEDDING_MODEL=google/embeddinggemma-300m
# Embedding full dimension (dim_full). Default 768 (EmbeddingGemma). Set this to
# match your model; per-tier MRL prefixes (dim1/dim2/dim3/dim_coarse) live in the
# in-app settings and must satisfy dim_full ≥ dim1 ≥ dim2 ≥ dim3 ≥ dim_coarse > 0.
EMBEDDING_DIM=768
