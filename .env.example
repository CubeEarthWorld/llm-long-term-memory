# Settings of the tools (`ltm run`, `ltm bench`). Copy to `secrets/.env`; the
# `secrets/` directory is git-ignored. The engram library itself reads no settings.

# Claude through the Claude Code CLI (no API key here). Answers are cached per prompt
# in LLM_CACHE, so a replayed scenario asks the model only once.
CLAUDE_MODEL=claude-haiku-5-5
# CLAUDE_CLI=claude
# LLM_CACHE=data/llm_cache.json

# EmbeddingGemma GGUF file name inside ./model (or an absolute path)
# https://ai.google.dev/gemma/docs/embeddinggemma
EMBEDDING_MODEL=embeddinggemma-300m-qat-Q4_0.gguf

# Timezone stamped onto memories
MEMORY_TZ=Asia/Tokyo
