# Copy to `secrets/.env` and fill in real values. The `secrets/` directory is git-ignored.

# LLM provider: "claude-code" (default: Claude via the Claude Code CLI, answers cached
# per prompt in LLM_CACHE so a replayed scenario asks only once), "deepseek" or "gemini"
LLM_PROVIDER=claude-code
CLAUDE_MODEL=claude-haiku-5-5
# CLAUDE_CLI=claude
# LLM_CACHE=data/llm_cache.json

# Deepseek (OpenAI-compatible) — https://api-docs.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_key_here
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Gemini (optional) — https://ai.google.dev/gemini-api/docs/quickstart
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-3.5-flash

# EmbeddingGemma GGUF file name inside ./model (or an absolute path)
# https://ai.google.dev/gemma/docs/embeddinggemma
EMBEDDING_MODEL=embeddinggemma-300m-qat-Q4_0.gguf
# Optional: embed through an OpenAI-compatible /embeddings endpoint instead of the local GGUF
# (llama-server, Ollama, LM Studio, OpenAI). EMBEDDING_MODEL is then the model name there.
# EMBEDDING_URL=http://localhost:8080/v1
# EMBEDDING_API_KEY=

# Timezone stamped onto memories
MEMORY_TZ=Asia/Tokyo
